plmswia-59f2441233eb678c2c198878cc8d7d6518283493,Sanction:id,28a2fac1c724f9a084c43d1738b27f447bfbfd81,pl_mswia_sanctions,pol,,,,2025-04-28T19:38:23,2025-04-28T19:38:23
plmswia-osoby-kolabau-anton,Person:firstName,Anton,pl_mswia_sanctions,pol,,,,2025-04-28T19:38:23,2025-04-28T19:38:23
plmswia-osoby-kolabau-anton,Person:lastName,KOLABAU,pl_mswia_sanctions,pol,,,,2025-04-28T19:38:23,2025-04-28T19:38:23
plmswia-osoby-kolabau-anton,Person:name,Anton KOLABAU,pl_mswia_sanctions,pol,,,,2025-04-28T19:38:23,2025-04-28T19:38:23
plmswia-osoby-kolabau-anton,Person:notes,"Obywatel Białorusi Anton Kolabau jest sędzią Sądu Rejonowego w Mińsku, zaangażowanym w masowe łamanie praw człowieka na Białorusi. Z informacji posiadanych przez Agencję Bezpieczeństwa Wewnętrznego wynika, że wjazd i pobyt obywatela Białorusi stanowią zagrożenie dla bezpieczeństwa państwa. Dotychczasowa aktywność wymienionej osoby sytuuje ją jako zwolennika reżimu Aleksandra Łukaszenki. Taka postawa w obliczu rosyjskich działań wojennych na Ukrainie, wsparcia logistycznego i politycznego udzielonego Moskwie przez władze białoruskie, a także toczonej wobec Rzeczypospolitej wojny hybrydowej stwarza poważne ryzyko prowokacji lub wywołania incydentów skutkujących uszczerbkiem dla pozycji międzynarodowej RP.",pl_mswia_sanctions,pol,,,,2025-04-28T19:38:23,2025-04-28T19:38:23
plmswia-osoby-kolabau-anton,Person:birthDate,1987-12-07,pl_mswia_sanctions,pol,7 grudnia 1987,,,2025-04-28T19:38:23,2025-04-28T19:38:23
plmswia-osoby-kolabau-anton,Person:topics,sanction,pl_mswia_sanctions,pol,,,,2025-04-28T19:38:23,2025-04-28T19:38:23
plmswia-osoby-kolabau-anton,Person:id,f93de43d634389ee544228ac829861c13ce64bd5,pl_mswia_sanctions,pol,,,,2025-04-28T19:38:23,2025-04-28T19:38:23
plmswia-8a1761c1e5413f9d2114299d3c66ee9a224938a8,Sanction:entity,plmswia-osoby-kolabau-anton,pl_mswia_sanctions,pol,,,,2025-04-28T19:38:23,2025-04-28T19:38:23
plmswia-8a1761c1e5413f9d2114299d3c66ee9a224938a8,Sanction:country,pl,pl_mswia_sanctions,pol,,,,2025-04-28T19:38:23,2025-04-28T19:38:23
plmswia-8a1761c1e5413f9d2114299d3c66ee9a224938a8,Sanction:authority,Ministerstwo Spraw Wewnętrznych i Administracji,pl_mswia_sanctions,pol,,,,2025-04-28T19:38:23,2025-04-28T19:38:23
