plmswia-2deb2d376b9daf32a916c9c3c7d225a84c5bf058,Sanction:id,ed9c03645b4413d210e76d83187543513e045263,pl_mswia_sanctions,pol,,,,2025-04-28T19:38:23,2025-04-28T19:38:23
plmswia-osoby-uladyka-iryna,Person:firstName,Iryna,pl_mswia_sanctions,pol,,,,2025-04-28T19:38:23,2025-04-28T19:38:23
plmswia-osoby-uladyka-iryna,Person:lastName,ULADYKA,pl_mswia_sanctions,pol,,,,2025-04-28T19:38:23,2025-04-28T19:38:23
plmswia-osoby-uladyka-iryna,Person:name,Iryna ULADYKA,pl_mswia_sanctions,pol,,,,2025-04-28T19:38:23,2025-04-28T19:38:23
plmswia-osoby-uladyka-iryna,Person:notes,"Obywatelka Białorusi Iryna Uladyka jest sędzią Sądu Rejonowego w m. Homel, zaangażowaną w masowe łamanie praw człowieka na Białorusi. Z informacji posiadanych przez Agencję Bezpieczeństwa Wewnętrznego wynika, że wjazd i pobyt obywatelki Białorusi stanowią zagrożenie dla bezpieczeństwa państwa. Dotychczasowa aktywność wymienionej osoby sytuuje ją jako zwolennika reżimu Aleksandra Łukaszenki. Taka postawa w obliczu rosyjskich działań wojennych na Ukrainie, wsparcia logistycznego i politycznego udzielonego Moskwie przez władze białoruskie, a także toczonej wobec Rzeczypospolitej wojny hybrydowej stwarza poważne ryzyko prowokacji lub wywołania incydentów skutkujących uszczerbkiem dla pozycji międzynarodowej RP.",pl_mswia_sanctions,pol,,,,2025-04-28T19:38:23,2025-04-28T19:38:23
plmswia-osoby-uladyka-iryna,Person:birthDate,1958-08-13,pl_mswia_sanctions,pol,13 sierpnia 1958,,,2025-04-28T19:38:23,2025-04-28T19:38:23
plmswia-osoby-uladyka-iryna,Person:topics,sanction,pl_mswia_sanctions,pol,,,,2025-04-28T19:38:23,2025-04-28T19:38:23
