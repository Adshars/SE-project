plmswia-osoby-zdorykava-liudmila,Person:firstName,Liudmila,pl_mswia_sanctions,pol,,,,2025-04-28T19:38:23,2025-04-28T19:38:23
plmswia-osoby-zdorykava-liudmila,Person:lastName,ZDORYKAVA,pl_mswia_sanctions,pol,,,,2025-04-28T19:38:23,2025-04-28T19:38:23
plmswia-osoby-zdorykava-liudmila,Person:name,Liudmila ZDORYKAVA,pl_mswia_sanctions,pol,,,,2025-04-28T19:38:23,2025-04-28T19:38:23
plmswia-osoby-zdorykava-liudmila,Person:notes,"Obywatelka Białorusi Liudmila Zdorykava jest członkiem Izby Reprezentantów Zgromadzenia Narodowego RB. Brała udział w uchwalaniu prawa mającego na celu represjonowanie obywateli Białorusi. Z informacji posiadanych przez Agencję Bezpieczeństwa Wewnętrznego wynika, że wjazd i pobyt obywatelki Białorusi stanowią zagrożenie dla bezpieczeństwa państwa. Dotychczasowa aktywność wymienionej osoby sytuuje ją jako zwolennika reżimu Aleksandra Łukaszenki. Taka postawa w obliczu rosyjskich działań wojennych na Ukrainie, wsparcia logistycznego i politycznego udzielonego Moskwie przez władze białoruskie, a także toczonej wobec Rzeczypospolitej wojny hybrydowej stwarza poważne ryzyko prowokacji lub wywołania incydentów skutkujących uszczerbkiem dla pozycji międzynarodowej RP.",pl_mswia_sanctions,pol,,,,2025-04-28T19:38:23,2025-04-28T19:38:23
plmswia-osoby-zdorykava-liudmila,Person:birthDate,1973-05-09,pl_mswia_sanctions,pol,9 maja 1973,,,2025-04-28T19:38:23,2025-04-28T19:38:23
plmswia-osoby-zdorykava-liudmila,Person:topics,sanction,pl_mswia_sanctions,pol,,,,2025-04-28T19:38:23,2025-04-28T19:38:23
plmswia-osoby-zdorykava-liudmila,Person:id,ddff3c503cf42f7fce40f2abf0c1af242211efff,pl_mswia_sanctions,pol,,,,2025-04-28T19:38:23,2025-04-28T19:38:23
plmswia-352d676d6a9b933fc0af36a5153729d5ea660f92,Sanction:entity,plmswia-osoby-zdorykava-liudmila,pl_mswia_sanctions,pol,,,,2025-04-28T19:38:23,2025-04-28T19:38:23
