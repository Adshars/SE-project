plmswia-osoby-kananovich-yauheni,Person:firstName,Yauheni,pl_mswia_sanctions,pol,,,,2025-04-28T19:38:23,2025-04-28T19:38:23
plmswia-osoby-kananovich-yauheni,Person:lastName,KANANOVICH,pl_mswia_sanctions,pol,,,,2025-04-28T19:38:23,2025-04-28T19:38:23
plmswia-osoby-kananovich-yauheni,Person:name,Yauheni KANANOVICH,pl_mswia_sanctions,pol,,,,2025-04-28T19:38:23,2025-04-28T19:38:23
plmswia-osoby-kananovich-yauheni,Person:notes,"Obywatel Białorusi Yauheni Kananovich jest wydawcą gazety „SB Belarus Today”, aktywnie wspiera reżim A. Łukaszenki. Z informacji posiadanych przez Agencję Bezpieczeństwa Wewnętrznego wynika, że wjazd i pobyt obywatela Białorusi stanowią zagrożenie dla bezpieczeństwa państwa. Dotychczasowa aktywność wymienionej osoby sytuuje ją jako zwolennika reżimu Aleksandra Łukaszenki. Taka postawa w obliczu rosyjskich działań wojennych na Ukrainie, wsparcia logistycznego i politycznego udzielonego Moskwie przez władze białoruskie, a także toczonej wobec Rzeczypospolitej wojny hybrydowej stwarza poważne ryzyko prowokacji lub wywołania incydentów skutkujących uszczerbkiem dla pozycji międzynarodowej RP.",pl_mswia_sanctions,pol,,,,2025-04-28T19:38:23,2025-04-28T19:38:23
plmswia-osoby-kananovich-yauheni,Person:birthDate,1973-01-11,pl_mswia_sanctions,pol,11 stycznia 1973,,,2025-04-28T19:38:23,2025-04-28T19:38:23
plmswia-osoby-kananovich-yauheni,Person:topics,sanction,pl_mswia_sanctions,pol,,,,2025-04-28T19:38:23,2025-04-28T19:38:23
plmswia-osoby-kananovich-yauheni,Person:id,bfb23dc6acfe5790806feeef043c662ad0320003,pl_mswia_sanctions,pol,,,,2025-04-28T19:38:23,2025-04-28T19:38:23
plmswia-51e1b81eff82c56bc4728d21c324b5a04afda91d,Sanction:entity,plmswia-osoby-kananovich-yauheni,pl_mswia_sanctions,pol,,,,2025-04-28T19:38:23,2025-04-28T19:38:23
