plmswia-osoby-shkrob-maryna,Person:topics,sanction,pl_mswia_sanctions,pol,,,,2025-04-28T19:38:23,2025-04-28T19:38:23
plmswia-osoby-shkrob-maryna,Person:id,dc15e1da3e3b14db21762cb330457aa1aeb809d3,pl_mswia_sanctions,pol,,,,2025-04-28T19:38:23,2025-04-28T19:38:23
plmswia-772ab12c5542ae48430b7755cc5e7d8e97cdaeda,Sanction:entity,plmswia-osoby-shkrob-maryna,pl_mswia_sanctions,pol,,,,2025-04-28T19:38:23,2025-04-28T19:38:23
plmswia-772ab12c5542ae48430b7755cc5e7d8e97cdaeda,Sanction:country,pl,pl_mswia_sanctions,pol,,,,2025-04-28T19:38:23,2025-04-28T19:38:23
plmswia-772ab12c5542ae48430b7755cc5e7d8e97cdaeda,Sanction:authority,Ministerstwo Spraw Wewnętrznych i Administracji,pl_mswia_sanctions,pol,,,,2025-04-28T19:38:23,2025-04-28T19:38:23
plmswia-772ab12c5542ae48430b7755cc5e7d8e97cdaeda,Sanction:sourceUrl,https://www.gov.pl/web/mswia/decyzje-ministra-swia-w-sprawie-wpisu-na-liste-sankcyjna,pl_mswia_sanctions,pol,,,,2025-04-28T19:38:23,2025-04-28T19:38:23
plmswia-772ab12c5542ae48430b7755cc5e7d8e97cdaeda,Sanction:provisions,"a. zamrożenie wszystkich funduszy i zasobów gospodarczych, b. zakaz udostępniania osobie wpisanej na listę lub na jej rzecz – bezpośrednio lub pośrednio – jakichkolwiek funduszy lub zasobów gospodarczych, c. zakaz świadomego i umyślnego udziału w działaniach, których celem lub skutkiem jest ominięcie środków wskazanych w lit. a i b, d. wpis do wykazu cudzoziemców, których pobyt na terytorium Rzeczypospolitej Polskiej jest niepożądany",pl_mswia_sanctions,pol,,,,2025-04-28T19:38:23,2025-04-28T19:38:23
plmswia-772ab12c5542ae48430b7755cc5e7d8e97cdaeda,Sanction:startDate,2023-05-30,pl_mswia_sanctions,pol,30.05.2023,,,2025-04-28T19:38:23,2025-04-28T19:38:23
